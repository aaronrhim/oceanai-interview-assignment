# ─────────────────────────────────────────────────────────────────────────────
# OceanX AI demo — environment variables
#
# Copy to .env.local and fill in values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Required for live agents. If absent or invalid, the app falls back to
# DEMO_MODE=fixtures automatically (see below) so the demo stays alive.
ANTHROPIC_API_KEY=sk-ant-...

# Models. Defaults baked into code if unset, but documented here.
ANTHROPIC_MODEL_WORKER=claude-sonnet-4-6
ANTHROPIC_MODEL_SUPERVISOR=claude-opus-4-7

# DEMO_MODE controls how connectors and (optionally) agents behave:
#   live      — call real Anthropic, mock all third-party SaaS connectors
#   fixtures  — return canned outputs for everything; zero network calls
# Default is "live". Set to "fixtures" for a fully offline-safe demo.
DEMO_MODE=live

# Public origin used for SSE reconnect URLs and DocuSign mock callbacks.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Third-party SaaS keys — NOT required for the demo (all connectors are
# mocked). Listed here so a future swap to real sandboxes is one-flag.
# ─────────────────────────────────────────────────────────────────────────────

# APOLLO_API_KEY=
# HUBSPOT_PRIVATE_APP_TOKEN=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# GOCARDLESS_ACCESS_TOKEN=
# CIN7_API_KEY=
# CIN7_ACCOUNT_ID=
# WISE_API_TOKEN=
# WISE_PROFILE_ID=
# INSTANTLY_API_KEY=
# DRIPIFY_API_KEY=
